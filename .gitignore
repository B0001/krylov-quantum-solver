# 1. Python Compilation & Package Build Artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.pytest_cache/

# 2. Local Execution Telemetry & HPC Logs
# (We ignore the output data, but keep the log folder structure)
logs/*.log
logs/*.out
logs/*.err
benchmark_results.csv
notes/

# 3. Generated Visualization Assets
*.png
*.pdf

# 4. Sphinx Documentation Builds
docs/build/

# 5. OS & Editor Trailing Artifacts
.DS_Store
*~
*.swp
.vscode/
.idea/

# 6. Virtual Environments (If created locally in the future)
venv/
env/
.venv/

# 7. Environment Variables & Secrets
.env
*.env

data/
# block2 DMRG scratch (benchmark_dmrg.py)
.dmrg_tmp/

# Loki Mode scratch/trust-layer state
.loki/
.gates-cache/
logs/gates/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
