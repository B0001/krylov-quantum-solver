# Keep the build context small and the image reproducible.
# Without this, `docker build` ships .git, the host .venv (wrong platform), and the DMRG scratch
# directory into the daemon on every build.

.git
.gitignore
.venv
__pycache__
**/__pycache__
*.pyc
*.egg-info
**/*.egg-info

# block2 DMRG scratch (git-ignored, can be GBs)
.dmrg_tmp

# Local execution telemetry / results -- regenerated by the benchmarks, not inputs to them
data
results
logs
.loki

# Editor/OS noise
.DS_Store
.idea
.vscode
.claude
